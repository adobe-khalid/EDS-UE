{
  "definitions": [
    {
      "title": "Tabs Fragment",
      "id": "tabs-fragment",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Tabs Fragment",
              "filter": "tabs-fragment"
            }
          }
        }
      }
    },
    {
      "title": "Tab Item",
      "id": "tab-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Tab Item",
              "model": "tab-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "tab-item",
      "fields": [
        {
          "component": "text",
          "name": "tab-name",
          "label": "Tab Name",
          "description": "Enter the name of the tab",
          "valueType": "string",
          "required": true
        },
        {
          "component": "text",
          "name": "tab-id",
          "label": "TAB ID URL",
          "description": "Enter the unique tab ID which needs to be displayed in the URL",
          "valueType": "string",
          "required": true
        },
        {
          "component": "aem-content",
          "name": "fragment",
          "label": "Fragment Path",
          "description": "Enter the path to the fragment (e.g., /fragments/my-fragment)",
          "valueType": "string",
          "validation": {
            "rootPath": "/content/khalid-EDS"
          }
        },
        {
          "component": "checkbox-group",
          "name": "back-to-tab",
          "label": "",
          "valueType": "string",
          "options": [{ "name": "Back to Tabs", "value": "show-back-to-tabs" }]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "tabs-fragment",
      "components": ["tab-item"]
    }
  ]
}
